{
  "name": "markdown-editor",
  "productName": "MarkdownEditor",
  "version": "0.1.0",
  "private": true,
  "description": "A Typora-like WYSIWYG Markdown editor built with Electron + Vue 3 + CodeMirror 6",
  "main": "out/main/index.js",
  "author": "MarkdownEditor Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "clean:release": "node scripts/clean-release.cjs",
    "dist": "npm run clean:release && electron-vite build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run clean:release && electron-vite build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "npm run clean:release && electron-vite build && electron-builder --mac --config electron-builder.yml",
    "dist:linux": "npm run clean:release && electron-vite build && electron-builder --linux --config electron-builder.yml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@mdit/plugin-katex": "^1.1.3",
    "buffer": "^6.0.3",
    "chokidar": "^6.0.0",
    "docx": "^9.13.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "iconv-lite": "^0.6.3",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  }
}
